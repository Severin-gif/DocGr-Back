{
  "name": "docgrid-back",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "check": "prisma generate && tsc --noEmit",
    "test": "npm run build && node --test dist/*.test.js && npm run test:domain",
    "test:domain": "node scripts/docgrid-core-test.cjs && node scripts/astra-docgrid-test.cjs && node scripts/docgrid-upload-extraction-test.cjs && node scripts/office-view-test.cjs",
    "db:migrate": "node scripts/migrate.cjs",
    "test:postgres": "node scripts/standalone-http-test.cjs",
    "test:embedded": "npm run build && node scripts/standalone-http-test.cjs --embedded"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "5.22.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cors": "^2.8.5",
    "docx": "^9.5.1",
    "dotenv": "^17.2.2",
    "express": "5.2.1",
    "helmet": "^8.1.0",
    "jszip": "3.10.2",
    "parse5": "7.3.0",
    "pg": "^8.16.3",
    "prisma": "5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=24"
  }
}

