NODE_ENV=production
PORT=4000
DOCGRID_PUBLIC_ORIGIN=https://api.docgrid.ru
CORS_ORIGINS=https://docgrid.ru,https://www.docgrid.ru
# Dedicated DB is preferred; all tables and the migration ledger live in schema docgrid.
DATABASE_URL=postgresql://docgrid:CHANGE_ME@HOST:5432/docgrid?schema=docgrid
# Same DocGrid identity issuer/secret as AI-Orchestra; passwords stay there.
DOCGRID_IDENTITY_JWT_SECRET=
DOCGRID_IDENTITY_ISSUER=ai-orchestra
# Existing issuer's audience retained to avoid breaking deployed login.
DOCGRID_IDENTITY_AUDIENCE=legal-core-docgrid
# Retained for OAuth sealing and optional AI-Orchestra review integration; min 32 chars.
DOCGRID_SERVICE_TOKEN=
DOCGRID_ADMIN_TOKEN=
DOCGRID_ORCHESTRA_URL=
# Set s3 after configuring the private bucket. Existing originals remain readable.
DOCGRID_MATERIAL_STORAGE=database
DOCGRID_S3_ENDPOINT=
DOCGRID_S3_BUCKET=
DOCGRID_S3_REGION=
DOCGRID_S3_ACCESS_KEY_ID=
DOCGRID_S3_SECRET_ACCESS_KEY=
DOCGRID_S3_FORCE_PATH_STYLE=true
# Optional persistent backup volume; pg_dump is restricted to schema docgrid.
DOCGRID_BACKUP_DIR=
LIBREOFFICE_BIN=soffice
UPSTREAM_TIMEOUT_MS=90000
MAX_RESPONSE_BYTES=32000000
