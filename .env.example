NODE_ENV=development
PORT=4000

# Internal upstream that owns DocGrid repositories/branches/commits/reviews.
# In production use the existing legal-core HTTPS origin.
LEGAL_CORE_URL=https://sps.codex-chat.ru

# Public browser origins allowed to call api.docgrid.ru.
CORS_ORIGINS=https://docgrid.ru,https://www.docgrid.ru,http://localhost:3000

# AI Review may legitimately take longer than ordinary CRUD calls.
UPSTREAM_TIMEOUT_MS=90000
UPSTREAM_READY_TIMEOUT_MS=5000

# Bounded buffered JSON response from legal-core (bytes).
MAX_RESPONSE_BYTES=32000000
